profile {
    // Profile for syntax highlighting in Go tests
    // Use it to run Go tests like this:
    //   go test ./... -v | neocolor -p golang-test

    // Or, for your convenience, you can create aliases like these:
    //   alias gt='go test ./... | neocolor -p golang-test'
    //   alias gtv='go test ./... -v | neocolor -p golang-test'
    golang-test {
        yellow "TEST:.*"
        red    "--- FAIL:.*" "FAIL:.*"
        green  "--- PASS:.*" "^PASS$" "ok.*"
        purple "^PASS$"
        cyan   #"'[^\s]+\.go(:\d+)?'"#
    }
}
